{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"],
    "paths": {
      "obsidian": ["../node_modules/obsidian"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
